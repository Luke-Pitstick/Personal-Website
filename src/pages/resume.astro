---
import Layout from '../layouts/Layout.astro';
import { SITE_SHELL } from '../components/SectionChrome';
import ResumeViewer from '../components/ResumeViewer.jsx';

const resumeUrl = '/Luke_Pitstick_Resume.pdf';
---

<Layout title="Luke Pitstick | Resume" description="View and download Luke Pitstick's resume.">
	<main id="main-content" class="relative min-h-screen bg-[#f8f7f1] pt-24 text-[#101617] sm:pt-28">
		<section class={`${SITE_SHELL} py-8 md:py-12`} aria-labelledby="resume-heading">
			<header class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b-[3px] border-[#101617] pb-5 shadow-[0_3px_0_0_#ff3a12]">
				<h1 id="resume-heading" class="font-heading text-3xl font-bold md:text-4xl">Resume</h1>
				<div class="flex flex-wrap items-center gap-4">
					<a href={resumeUrl} download class="focus-ring inline-flex min-h-11 items-center rounded-lg border-2 border-[#101617] bg-white px-5 py-3 font-body text-sm font-extrabold transition-colors hover:bg-[#ffda18]">
						Download Resume
					</a>
				</div>
			</header>
			<ResumeViewer file={resumeUrl} client:only="react" />
		</section>
	</main>
</Layout>
