---
import { Github, Linkedin, Mail } from 'lucide-react';

const emailAddress = 'lukepitstick06@gmail.com';
---

<div
  class="hero-content-parallax pointer-events-none relative z-30 mx-auto grid min-h-screen w-full max-w-6xl content-start justify-items-center pb-24 pt-[clamp(9.5rem,24vh,14rem)] text-center"
>
  <div class="mx-auto flex w-full max-w-2xl flex-col items-center">
    <div class="hero-identity motion-reveal [--motion-delay:0.18s] [--reveal-scale:0.98] [--reveal-y:16px]">
      <h1 class="dithered-hero-title m-0 whitespace-nowrap text-center font-heading font-bold">
        Luke Pitstick
      </h1>
      <p aria-label="Hackathon awards" class="m-0 px-2 font-body text-xs font-semibold leading-relaxed text-[#334044] sm:text-sm">
        <span class="font-extrabold text-[#101617]">2× Hackathon Winner</span>
        <span class="block sm:inline"><span aria-hidden="true" class="hidden sm:inline"> · </span>BlasterHacks 1st Place · HackCU Winner</span>
      </p>
    </div>

    <div class="hero-details mt-5 flex w-full flex-col items-center gap-8 sm:mt-6 md:mt-7 md:gap-8">
    <p
      class="motion-reveal w-full bg-[#101617] px-3 py-2 font-body text-base font-extrabold leading-relaxed text-[#f5f0d8] shadow-[8px_8px_0_rgba(255,58,18,0.9)] sm:text-xl md:text-2xl [--motion-delay:0.38s] [--reveal-y:12px]"
    >
      AI/ML research and software development for deep technical problems.
    </p>

    <p
      class="motion-reveal m-0 max-w-xl rounded-sm border-2 border-[#101617] bg-[#faf9f4]/95 px-4 py-3 font-body text-base font-extrabold leading-relaxed text-[#101617] sm:text-lg [--motion-delay:0.48s] [--reveal-y:12px]"
    >
      Seeking Summer 2027 AI/ML, Software Engineering, Data Science &amp; Technical Product internships
    </p>

    <div
      id="hero-socials"
      class="pointer-events-auto flex w-full flex-wrap justify-center gap-4 pt-2 transition-[opacity,transform] duration-300 ease-out sm:gap-5 translate-y-0 opacity-100"
    >
      <a
        href="https://github.com/Luke-Pitstick"
        target="_blank"
        rel="noopener noreferrer"
        class="focus-ring motion-reveal inline-flex size-12 items-center justify-center rounded-full border-2 border-[#101617] bg-[#faf9f4] text-[#101617] shadow-[3px_3px_0_0_rgba(16,22,23,0.85)] transition-[background-color,box-shadow,color,transform] duration-300 hover:-translate-y-1 hover:bg-[#ffda18] hover:shadow-[5px_5px_0_0_rgba(255,58,18,0.95)] [--reveal-scale:0.92] [--reveal-y:12px] [--motion-delay:0.62s]"
        aria-label="Visit Luke Pitstick's GitHub profile"
        title="GitHub"
      >
        <Github aria-hidden="true" size={22} strokeWidth={2.25} />
      </a>
      <a
        href="https://www.linkedin.com/in/luke-pitstick"
        target="_blank"
        rel="noopener noreferrer"
        class="focus-ring motion-reveal inline-flex size-12 items-center justify-center rounded-full border-2 border-[#101617] bg-[#faf9f4] text-[#101617] shadow-[3px_3px_0_0_rgba(16,22,23,0.85)] transition-[background-color,box-shadow,color,transform] duration-300 hover:-translate-y-1 hover:bg-[#ffda18] hover:shadow-[5px_5px_0_0_rgba(255,58,18,0.95)] [--reveal-scale:0.92] [--reveal-y:12px] [--motion-delay:0.69s]"
        aria-label="Visit Luke Pitstick's LinkedIn profile"
        title="LinkedIn"
      >
        <Linkedin aria-hidden="true" size={22} strokeWidth={2.25} />
      </a>
      <a
        href={`mailto:${emailAddress}`}
        class="focus-ring motion-reveal inline-flex size-12 items-center justify-center rounded-full border-2 border-[#101617] bg-[#faf9f4] text-[#101617] shadow-[3px_3px_0_0_rgba(16,22,23,0.85)] transition-[background-color,box-shadow,color,transform] duration-300 hover:-translate-y-1 hover:bg-[#ffda18] hover:shadow-[5px_5px_0_0_rgba(255,58,18,0.95)] [--reveal-scale:0.92] [--reveal-y:12px] [--motion-delay:0.76s]"
        aria-label="Email Luke Pitstick"
        title="Email"
      >
        <Mail aria-hidden="true" size={22} strokeWidth={2.25} />
      </a>
    </div>
    </div>
  </div>
</div>
